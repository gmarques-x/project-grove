#!/bin/bash
# grove-themes: switch the desktop between the six Everforest schemes.

_gt_usage() {
  cat <<'U'
usage: grove-themes <command>

commands:
  list                           the six schemes, the current one marked
  current                        the current scheme's name
  set SCHEME                     switch to SCHEME
  log [-n N]                     the last N switches (default 5), newest first
  logo [grove|avatar]            the terminal logo, or switch it
  wallpaper [grove|avatar]       the wallpaper set, or switch it
  render [--scheme S] [--config DIR]
                                 write the configs (default: current scheme,
                                 $GROVE_ROOT/config)

options:
  --json   machine-readable output on list, current, set, log, logo and wallpaper
U
}

# Resolve this script's folder through symlinks (bash 3.2 safe).
_gt_self_root() {
  local src="$0" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  (cd -P "$(dirname "$src")/.." && pwd)
}

GT_ROOT="$(_gt_self_root)" || exit 1
export GROVE_ROOT="${GROVE_ROOT:-$GT_ROOT/../grove-dotfiles}"
export GROVE_STATE="${GROVE_STATE:-$HOME/.local/state/grove}"

# shellcheck source=/dev/null
. "$GT_ROOT/lib/render.sh"
# shellcheck source=/dev/null
. "$GT_ROOT/lib/state.sh"
# shellcheck source=/dev/null
. "$GT_ROOT/lib/steps.sh"
# shellcheck source=/dev/null
. "$GT_ROOT/lib/log.sh"

_gt_json_list() { # words -> "a", "b"
  local out="" s
  for s in "$@"; do out="$out${out:+, }\"$s\""; done
  printf '%s' "$out"
}

_gt_json_esc() {
  local tab cr
  tab="$(printf '\t')"; cr="$(printf '\r')"
  printf '%s' "$1" | tr '\n' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$tab/\\\\t/g" -e "s/$cr/\\\\r/g" \
    | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'
}

_gt_unknown() {
  echo "grove-themes: unknown scheme: $1" >&2
  echo "schemes:" >&2
  gt_schemes | sed 's/^/  /' >&2
  exit 2
}

# _gt_palette_json SCHEME: {"name": ..., "appearance": ..., "colors": {...}}
# The colours the apps draw with: the backgrounds, fg, grey1, the seven
# accents, then the four roles (border, on_accent, dim, lockup_ink).
_gt_palette_json() {
  local s="$1" tab name val colors="" sep="" app="" vals c title
  tab="$(printf '\t')"
  vals="$(gt_values "$s" "$GROVE_ROOT/theme")" || return 1
  for c in bg0 bg1 bg2 bg3 fg grey1 red orange yellow green aqua blue purple border on_accent dim lockup_ink; do
    val="$(printf '%s\n' "$vals" | while IFS="$tab" read -r name val; do
      [ "$name" = "$c" ] && { printf '%s' "$val"; break; }
    done)"
    colors="$colors$sep\"$c\": \"$val\""
    sep=", "
  done
  app="$(printf '%s\n' "$vals" | while IFS="$tab" read -r name val; do
    [ "$name" = appearance ] && { printf '%s' "$val"; break; }
  done)"
  title="$(printf '%s' "$s" | awk -F- '{ for (i = 1; i <= NF; i++) printf "%s%s%s", (i > 1 ? " " : ""), toupper(substr($i, 1, 1)), substr($i, 2) }')"
  printf '{"name": "%s", "appearance": "%s", "colors": {%s}}' "$title" "$app" "$colors"
}

cmd_list() {
  local json="$1" cur s pal="" sep=""
  cur="$(gt_current)"
  if [ "$json" = 1 ]; then
    for s in $(gt_schemes); do
      pal="$pal$sep\"$s\": $(_gt_palette_json "$s")" || exit 1
      sep=", "
    done
    # shellcheck disable=SC2046
    printf '{"current": "%s", "schemes": [%s], "palettes": {%s}, "logo": "%s", "logos": [%s], "wallpaper": "%s", "wallpapers": [%s]}\n' \
      "$cur" "$(_gt_json_list $(gt_schemes))" "$pal" "$(gt_logo)" "$(_gt_json_list $(gt_logos))" \
      "$(gt_wallpaper)" "$(_gt_json_list $(gt_wallpapers))"
    return 0
  fi
  for s in $(gt_schemes); do
    if [ "$s" = "$cur" ]; then echo "* $s"; else echo "  $s"; fi
  done
}

cmd_current() {
  local json="$1" cur
  cur="$(gt_current)"
  if [ "$json" = 1 ]; then printf '{"current": "%s"}\n' "$cur"; else echo "$cur"; fi
}

cmd_log() {
  local json="$1" n=5 lines entry sep="" out="" l
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) [ $# -ge 2 ] || { _gt_usage >&2; exit 2; }; n="$2"; shift 2 ;;
      *) _gt_usage >&2; exit 2 ;;
    esac
  done
  case "$n" in ''|*[!0-9]*) _gt_usage >&2; exit 2 ;; esac
  lines="$(gt_log_read "$n")"
  [ -n "$lines" ] || { [ "$json" = 1 ] && echo '{"entries": []}'; exit 0; }
  if [ "$json" = 1 ]; then
    while IFS= read -r l; do out="$out$sep$l"; sep=", "; done <<< "$lines"
    printf '{"entries": [%s]}\n' "$out"
  else
    while IFS= read -r l; do
      entry="$(printf '%s' "$l" | sed -n 's/^{"time": "\([^"]*\)", "scheme": "\([^"]*\)", "exit": \([0-9]*\),.*/\1 \2 exit=\3/p')"
      [ -z "$entry" ] || echo "$entry"
    done <<< "$lines"
  fi
}

cmd_render() {
  local scheme="" cfg="$GROVE_ROOT/config"
  while [ $# -gt 0 ]; do
    case "$1" in
      --scheme) [ $# -ge 2 ] || { _gt_usage >&2; exit 2; }; scheme="$2"; shift 2 ;;
      --config) [ $# -ge 2 ] || { _gt_usage >&2; exit 2; }; cfg="$2"; shift 2 ;;
      *) _gt_usage >&2; exit 2 ;;
    esac
  done
  if [ -n "$scheme" ]; then
    gt_valid "$scheme" || _gt_unknown "$scheme"
  else
    scheme="$(gt_current)"
  fi
  gt_render_all "$scheme" "$cfg" || exit 1
}

# cmd_logo JSON [NAME]: print the terminal logo, or switch to NAME: render
# every config with it first (nothing moves unless all render), then save it
# and log a "logo" step.
cmd_logo() {
  local json="$1" name="$2" scheme tmp
  if [ -z "$name" ]; then
    if [ "$json" = 1 ]; then printf '{"logo": "%s"}\n' "$(gt_logo)"; else gt_logo; fi
    return 0
  fi
  case " $(gt_logos) " in *" $name "*) ;; *) _gt_usage >&2; exit 2 ;; esac
  scheme="$(gt_current)"
  # Render notes (backed-up hand edits) go to stderr: stdout stays the answer.
  GROVE_FETCH_LOGO="$name" gt_render_all "$scheme" "$GROVE_ROOT/config" >&2 || exit 1
  tmp="$GROVE_STATE/fetch-logo.tmp"
  if ! { mkdir -p "$GROVE_STATE" && echo "$name" > "$tmp" && mv -f "$tmp" "$GROVE_STATE/fetch-logo"; }; then
    echo "grove-themes: could not write $GROVE_STATE/fetch-logo" >&2
    exit 1
  fi
  gt_log_append "$scheme" 0 "$(printf '{"name": "logo", "result": "live", "message": "%s"}' "$name")" 2>/dev/null || true
  if [ "$json" = 1 ]; then printf '{"logo": "%s"}\n' "$name"; else echo "grove-themes: logo $name"; fi
}

# cmd_wallpaper JSON [NAME]: print the wallpaper set, or switch to NAME: the
# picture for the current scheme must exist; then save the choice (even if
# Automation is refused, so the next switch applies it), run the wallpaper
# step for the current scheme and log it. Configs are left alone.
cmd_wallpaper() {
  local json="$1" name="$2" scheme file tmp line tab step res text rc=0
  if [ -z "$name" ]; then
    if [ "$json" = 1 ]; then printf '{"wallpaper": "%s"}\n' "$(gt_wallpaper)"; else gt_wallpaper; fi
    return 0
  fi
  case " $(gt_wallpapers) " in *" $name "*) ;; *) _gt_usage >&2; exit 2 ;; esac
  scheme="$(gt_current)"
  file="$(GROVE_WALLPAPER_SET="$name" gt_wallpaper_file "$scheme")"
  [ -r "$file" ] || { echo "grove-themes: wallpaper not found: $file" >&2; exit 1; }
  tmp="$GROVE_STATE/wallpaper.tmp"
  if ! { mkdir -p "$GROVE_STATE" && echo "$name" > "$tmp" && mv -f "$tmp" "$GROVE_STATE/wallpaper"; }; then
    echo "grove-themes: could not write $GROVE_STATE/wallpaper" >&2
    exit 1
  fi
  tab="$(printf '\t')"
  line="$(gt_step_wallpaper "$scheme")"
  IFS="$tab" read -r step res text <<< "$line"
  case "$res" in failed|needs-you) rc=1 ;; esac
  step="$(printf '{"name": "%s", "result": "%s", "message": "%s"}' "$step" "$res" "$(_gt_json_esc "$text")")"
  gt_log_append "$scheme" "$rc" "$step" 2>/dev/null || true
  if [ "$json" = 1 ]; then
    printf '{"wallpaper": "%s", "steps": [%s]}\n' "$name" "$step"
  else
    printf '%-11s %-12s %s\n' wallpaper "$res" "$text"
  fi
  exit "$rc"
}

cmd_set() {
  local json="$1" scheme="$2" msg="" result="live" rc=0 lines tab name res text out="" sep=""
  tab="$(printf '\t')"
  [ -n "$scheme" ] || { _gt_usage >&2; exit 2; }
  gt_valid "$scheme" || _gt_unknown "$scheme"
  if ! msg="$(gt_render_all "$scheme" "$GROVE_ROOT/config" 2>&1)"; then
    result="failed"
  elif ! gt_write_state "$scheme"; then
    result="failed"; msg="could not write $GROVE_STATE/theme"
  fi
  lines="configs$tab$result$tab$(printf '%s' "$msg" | tr '\n' ' ')"
  if [ "$result" != failed ]; then
    lines="$lines
$(gt_step_ghostty; gt_step_zsh; gt_step_static; gt_step_chrome; gt_step_yazi; gt_step_borders; gt_step_bar
      gt_step_appearance "$scheme"; gt_step_accent "$scheme"; gt_step_wallpaper "$scheme")"
  fi
  while IFS="$tab" read -r name res text; do
    case "$res" in failed|needs-you) rc=1 ;; esac
    out="$out$sep$(printf '{"name": "%s", "result": "%s", "message": "%s"}' "$name" "$res" "$(_gt_json_esc "$text")")"
    sep=", "
    if [ "$json" != 1 ]; then
      printf '%-11s %-12s %s\n' "$name" "$res" "$text"
    fi
  done <<< "$lines"
  [ "$result" = failed ] || gt_log_append "$scheme" "$rc" "$out" 2>/dev/null || true
  if [ "$json" = 1 ]; then
    printf '{"scheme": "%s", "steps": [%s]}\n' "$scheme" "$out"
  elif [ "$result" != failed ]; then
    echo "grove-themes: $scheme"
  fi
  exit "$rc"
}

json=0
args=()
for a in "$@"; do
  case "$a" in
    --json) json=1 ;;
    -h|--help) _gt_usage; exit 0 ;;
    *) args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
[ $# -ge 1 ] || { _gt_usage >&2; exit 2; }
cmd="$1"; shift
case "$cmd" in
  list) [ $# -eq 0 ] || { _gt_usage >&2; exit 2; }; cmd_list "$json" ;;
  current) [ $# -eq 0 ] || { _gt_usage >&2; exit 2; }; cmd_current "$json" ;;
  set) [ $# -le 1 ] || { _gt_usage >&2; exit 2; }; cmd_set "$json" "${1:-}" ;;
  log) cmd_log "$json" "$@" ;;
  logo) [ $# -le 1 ] || { _gt_usage >&2; exit 2; }; cmd_logo "$json" "${1:-}" ;;
  wallpaper) [ $# -le 1 ] || { _gt_usage >&2; exit 2; }; cmd_wallpaper "$json" "${1:-}" ;;
  render) cmd_render "$@" ;;
  *) _gt_usage >&2; exit 2 ;;
esac
