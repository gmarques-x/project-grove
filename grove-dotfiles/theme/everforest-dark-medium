# Grove additions
# The prompt's ─ fill line, carried over from the Everforest zsh port.
fill = #596763
# Roles: what a colour is for, so a config names the job and each scheme picks
# the colour that does it. In the dark schemes they are the colours the configs
# always used.
# Lines between things: window borders, the bar's outline and separators, boxes.
border    = #475258
# Text on an accent-coloured block (the prompt's segments, the focused workspace).
on_accent = #2D353B
# Quiet text: labels, notes.
dim       = #859289
# Terminal colors (ANSI 0-15), upstream maps normal and bright slots to the same
# colors. Bright black (ANSI 8) is grey1 instead of upstream's bg3, so dim
# terminal text stays readable. A mapping, not a new color.
term0  = #475258
term1  = #E67E80
term2  = #A7C080
term3  = #DBBC7F
term4  = #7FBBB3
term5  = #D699B6
