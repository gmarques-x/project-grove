# Backgrounds
bg_dim    = #232A2E
bg0       = #2D353B
bg1       = #343F44
bg2       = #3D484D
bg3       = #475258
bg4       = #4F585E
bg5       = #56635F
bg_visual = #543A48
bg_red    = #514045
bg_yellow = #4D4C43
bg_green  = #425047
bg_blue   = #3A515D
