# Everforest Light Medium, the Project Grove palette.
# Every color a Grove config uses must appear here (tests/theme.bats checks).
# Format: name = #RRGGBB. Lines starting with # are comments.

# Upstream (Light Medium)
# Source: https://github.com/sainnhe/everforest/blob/master/autoload/everforest.vim
# Copyright (c) Sainnhe Park, MIT License.

# Backgrounds
bg_dim    = #EFEBD4
bg0       = #FDF6E3
bg1       = #F4F0D9
bg2       = #EFEBD4
bg3       = #E6E2CC
bg4       = #E0DCC7
bg5       = #BDC3AF
bg_visual = #EAEDC8
bg_red    = #FDE3DA
bg_yellow = #FAEDCD
bg_green  = #F0F1D2
bg_blue   = #E9F0E9
bg_purple = #FAE8E2

# Foregrounds
fg     = #5C6A72
red    = #F85552
orange = #F57D26
yellow = #DFA000
green  = #8DA101
aqua   = #35A77C
blue   = #3A94C5
purple = #DF69BA
grey0  = #A6B0A0
grey1  = #939F91
grey2  = #829181

# Grove additions
# The prompt's ─ fill line, the scheme's bg5.
fill = #BDC3AF
# Roles: what a colour is for, so a config names the job and each scheme picks
# the colour that does it. The light schemes need other picks than the dark
# ones to stay readable on a pale background.
# Lines between things: bg5, since bg3 on bg0 is only 1.2:1 here (1.7:1 now,
# as bg3 is in the dark schemes).
border    = #BDC3AF
# Text on an accent-coloured block: the dark medium scheme's bg0 as ink. This
# scheme's own bg0 or fg on its accents is 1.7 to 3.3:1; the ink is 3.3 to 6:1.
on_accent = #2D353B
# Quiet text: grey2, the darkest grey here (grey1 is 2.3 to 2.7:1 on bg0).
dim       = #829181
# The fill under the pointer: bg3 (bg1 on bg0 is 1.06:1 here; bg3 is about
# 1.2:1, as soft as bg1 is in the dark schemes).
hover     = #E6E2CC
# Text that steps back but is read: fg, since no grey here reaches 3.3:1.
muted     = #5C6A72
# The wordmark's ink ("Project Grove" and its pine, on this scheme's bg0): the
# branding's dark ink, the same in every light scheme. The lockup's own
# colour, not an Everforest one (near dark hard's bg0, #272E33, but not it).
lockup_ink = #27332A
# Terminal colors (ANSI 0-15), upstream maps normal and bright slots to the same
# colors. Bright black (ANSI 8) is grey1 instead of upstream's fg, so dim
# terminal text stays readable. Bright white (ANSI 15) is fg instead of
# upstream's bg3, which can't be read on bg0. Mappings, not new colors.
term0  = #5C6A72
term1  = #F85552
term2  = #8DA101
term3  = #DFA000
term4  = #3A94C5
term5  = #DF69BA
term6  = #35A77C
term7  = #E6E2CC
term8  = #939F91
term9  = #F85552
term10 = #8DA101
term11 = #DFA000
term12 = #3A94C5
term13 = #DF69BA
term14 = #35A77C
term15 = #5C6A72
