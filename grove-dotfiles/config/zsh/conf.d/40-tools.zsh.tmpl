# zoxide replaces cd (`builtin cd` still reaches the original); fzf binds
# ⌃R (history), ⌃T (files) and ⌥C (folders), in Everforest colors.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh --cmd cd)"
fi
if (( $+commands[fzf] )); then
  if (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
  export FZF_DEFAULT_OPTS="--color=bg:{{bg0}},bg+:{{bg_visual}},fg:{{fg}},fg+:{{fg}},hl:{{green}},hl+:{{green}},prompt:{{aqua}},pointer:{{red}},marker:{{yellow}},info:{{grey1}},spinner:{{aqua}},header:{{blue}},border:{{bg3}}"
  source <(fzf --zsh)
fi
