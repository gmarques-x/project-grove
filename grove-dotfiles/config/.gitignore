/*
!/.gitignore
!/git/
!/ssh/
/ssh/*
!/ssh/config
!/zsh/
!/ghostty/
!/chrome-theme/
/chrome-theme/*
!/chrome-theme/manifest.json.tmpl
!/fastfetch/
!/bat/
!/eza/
!/yazi/
!/vscode/
!/borders/
!/aerospace/
!/sketchybar/
/aerospace/aerospace.toml
!/grove-keys/
!/starship.toml.tmpl
!/starship-plain.toml.tmpl

/git/local
/git/allowed_signers
/zsh/.zsh_sessions
/zsh/.zsh_history
/zsh/.zcompdump*

# Generated by grove-themes from the *.tmpl next to them (spec §5): only the
# templates are tracked.
/ghostty/config
/fastfetch/config.jsonc
/eza/theme.yml
/yazi/theme.toml
/yazi/init.lua
/vscode/settings.json
/borders/bordersrc
/sketchybar/colors.sh
/zsh/conf.d/40-tools.zsh
/zsh/conf.d/85-autosuggest.zsh
/zsh/conf.d/95-fetch.zsh
/zsh/conf.d/98-highlight.zsh
