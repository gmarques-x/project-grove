{
  "manifest_version": 3,
  "name": "Grove",
  "version": "1.0",
  "description": "Project Grove's Everforest theme, rendered by grove-themes.",
  "theme": {
    "colors": {
      "frame": [{{bg_dim_rgb}}],
      "frame_inactive": [{{bg_dim_rgb}}],
      "frame_incognito": [{{bg_dim_rgb}}],
      "frame_incognito_inactive": [{{bg_dim_rgb}}],
      "toolbar": [{{bg0_rgb}}],
      "ntp_background": [{{bg0_rgb}}],
      "tab_text": [{{fg_rgb}}],
      "bookmark_text": [{{fg_rgb}}],
      "ntp_text": [{{fg_rgb}}],
      "toolbar_text": [{{fg_rgb}}],
      "omnibox_text": [{{fg_rgb}}],
      "tab_background_text": [{{grey1_rgb}}],
      "tab_background_text_inactive": [{{grey1_rgb}}],
      "toolbar_button_icon": [{{grey2_rgb}}],
      "omnibox_background": [{{bg1_rgb}}],
      "ntp_link": [{{green_rgb}}],
      "button_background": [{{bg1_rgb}}]
    },
    "properties": {
      "ntp_logo_alternate": 1
    }
  }
}
