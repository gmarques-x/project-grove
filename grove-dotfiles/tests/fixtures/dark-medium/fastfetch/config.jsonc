// Project Grove · fastfetch: the summary shown in every new terminal window
// (zsh/conf.d/95-fetch.zsh picks the logo: this image in wide Ghostty windows,
// grove.ascii in narrower ones and in Terminal.app, none when very narrow).
// The stats sit in a 58-column box titled Grove. Every color comes from
// theme/everforest-dark-medium, written as hex ({##RRGGBB} inside formats).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // The README banner's logo and lettering in the paper's light tone, on a
    // transparent background; Ghostty reads the file itself. 76 x 15 cells,
    // 3 rows down, so it sits centred beside the 22-row box.
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/grove.png",
    "width": 76,
    "height": 15,
    "preserveAspectRatio": true,
    "padding": { "left": 1, "right": 3, "top": 3 }
  },
  "display": {
    "brightColor": false,
    "separator": "\uf1b2  ",
    "color": { "keys": "#A7C080", "separator": "#859289", "output": "#D3C6AA", "title": "#D3C6AA" },
    // $1: a box row's two edges (left edge, jump right, right edge, jump back).
    // $2: an empty box row.
    "constants": [
      "│\u001b[56C│\u001b[57D",
      "│                                                        │"
    ],
    "bar": {
      "char": { "elapsed": "▮ ", "total": "▮ " },
      "border": { "left": "", "right": "" },
      "width": 10,
      "color": { "elapsed": "#A7C080", "total": "#475258" }
    },
    "percent": { "type": 2 }
  },
  "modules": [
    { "type": "custom", "format": "{##D3C6AA}┌ Grove ─────────────────────────────────────────────────┐" },
    { "type": "custom", "format": "{##D3C6AA}{$2}" },
    { "type": "title", "key": "{##D3C6AA}{$1}{#keys}  󰒋 Host        ", "format": "{user-name}@{host-name}" },
    { "type": "host", "key": "{##D3C6AA}{$1}{#keys}  󰌢 Machine     ", "format": "{name}" },
    { "type": "kernel", "key": "{##D3C6AA}{$1}{#keys}  \uf013 Kernel       " },
    { "type": "os", "key": "{##D3C6AA}{$1}{#keys}  \uf179 OS           ", "format": "{name} {version}" },
    { "type": "wm", "key": "{##D3C6AA}{$1}{#keys}  \uf2d0 WM           ", "format": "{?plugin-name}{plugin-name}{?}{/plugin-name}{pretty-name}{/}" },
    { "type": "packages", "key": "{##D3C6AA}{$1}{#keys}  \uf487 Packages     ", "format": "{all} (Homebrew)" },
    { "type": "terminal", "key": "{##D3C6AA}{$1}{#keys}  \uf120 Terminal     " },
    { "type": "shell", "key": "{##D3C6AA}{$1}{#keys}  \uf489 Shell        " },
    { "type": "localip", "key": "{##D3C6AA}{$1}{#keys}  \uf0ac Local IP     ", "format": "{ipv4}" },
    { "type": "brightness", "key": "{##D3C6AA}{$1}{#keys}  \uf185 Brightness   ", "format": "{percentage-bar}" },
    { "type": "display", "key": "{##D3C6AA}{$1}{#keys}  󰍹 Resolution  ", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "uptime", "key": "{##D3C6AA}{$1}{#keys}  \uf017 Uptime       " },
    { "type": "cpu", "key": "{##D3C6AA}{$1}{#keys}  \uf4bc CPU          " },
    { "type": "cpuusage", "key": "{##D3C6AA}{$1}{#keys}  \uf0e4 CPU Load     ", "format": "{avg-bar}" },
    { "type": "memory", "key": "{##D3C6AA}{$1}{#keys}  󰍛 Memory      ", "format": "{percentage-bar}" },
    { "type": "battery", "key": "{##D3C6AA}{$1}{#keys}  \uf240 Battery      ", "format": "{capacity-bar}" },
    { "type": "custom", "format": "{##D3C6AA}{$2}" },
    { "type": "colors", "key": "{##D3C6AA}{$1} ", "symbol": "circle", "paddingLeft": 0 },
    { "type": "custom", "format": "{##D3C6AA}{$2}" },
    { "type": "custom", "format": "{##D3C6AA}└────────────────────────────────────────────────────────┘" }
  ]
}
