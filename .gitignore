# macOS
.DS_Store

# Editor swap files (vim), e.g. while zalias has a file open
*.sw?
.*.sw?

# Font files are never committed (licenses). The 30-fonts module downloads
# them, and its local/ folder is for your own copies.
*.ttf
*.otf
*.dmg
grove-dotfiles/modules/30-fonts/local/*
!grove-dotfiles/modules/30-fonts/local/.gitkeep

# Settings recorders and their recordings: development tools for Gustavo and
# Claude, with personal data (recent folders, bookmarks, paths). Local only.
.recording/

# Shared working files between Gustavo and Claude. Never published.
artifacts/
